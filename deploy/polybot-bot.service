[Unit]
Description=Polybot unified daemon (bot + indexers + C1 + C2)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/polybot
Environment=PYTHONPATH=/root/polybot/src
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/root/polybot/.env
ExecStart=/root/polybot/.venv/bin/python -m polybot.daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
