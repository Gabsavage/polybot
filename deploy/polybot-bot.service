[Unit]
Description=Polybot Telegram Bot + C1 Sharp Money daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/polybot
Environment=PYTHONPATH=/root/polybot/src
ExecStart=/root/polybot/.venv/bin/python -m polybot.daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
