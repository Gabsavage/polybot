[Unit]
Description=Polybot On-chain Alchemy indexer
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/polybot
Environment=PYTHONPATH=/root/polybot/src
ExecStart=/root/polybot/.venv/bin/python -m polybot.indexers.onchain_alchemy
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
