[Unit]
Description=Polybot Data API trades indexer daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/polybot
ExecStart=/root/.local/bin/uv run --directory /root/polybot python -m polybot.indexers.trades_dataapi
Environment=PYTHONPATH=/root/polybot/src
Restart=always
RestartSec=10
StandardOutput=append:/var/log/polybot/trades-dataapi.log
StandardError=append:/var/log/polybot/trades-dataapi.log

[Install]
WantedBy=multi-user.target
