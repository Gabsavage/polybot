# DuckDB
DUCKDB_PATH=data/pm.duckdb

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=polybot-snapshots

# Polymarket APIs (no auth needed for read)
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com

# Snapshot config
SNAPSHOT_TOP_N=150
SNAPSHOT_MIN_VOLUME_24H=50000
SNAPSHOT_UNIVERSE_REFRESH_HOURS=6

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Phase C / future use
DUNE_API_KEY=
ALCHEMY_POLYGON_KEY=
